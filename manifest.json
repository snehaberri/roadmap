{
    "name": "Roadmap",
    "description": "A private research trail that turns what you read into a roadmap.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": ["storage", "tabs", "scripting"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
    "action": {
      "default_popup": "Roadmap.html",
      "default_icon": "Roadmap.png"
    }
}
